# =============================================================================
# HeyGoodly Production Environment Template (Copy -> /opt/heygoodly/.env on VPS)
# =============================================================================
APP_SLUG=heygoodly
SPRING_PROFILES_ACTIVE=prod
NODE_ENV=production

BIND_IP=127.0.0.1
FRONTEND_PORT=3001
BACKEND_PORT=8081

NEXT_PUBLIC_SITE_URL=https://heygoodly.com
NEXT_PUBLIC_API_URL=https://heygoodly.com
CORS_ALLOWED_ORIGINS=https://heygoodly.com,https://www.heygoodly.com
MINIO_PUBLIC_URL=https://heygoodly.com/media

# Must match /opt/shared-infra/.env
MINIO_ENDPOINT=http://shared-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET_NAME=heygoodly-media

POSTGRES_DB=heygoodly_db
POSTGRES_USER=heygoodly_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Generate via: openssl rand -base64 48
JWT_SECRET=Q0hBTkdFX01FX0pXVF9TRUNSRVJfNDhfQllURVNfT05fVlBTXzIwMjY=
JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
TWO_FACTOR_ISSUER=HeyGoodlyProCMS
AFFILIATE_DEFAULT_FALLBACK_URL=https://heygoodly.com

JAVA_TOOL_OPTIONS=-Xms256m -Xmx640m -XX:+UseG1GC
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=5
LOG_LEVEL_APP=INFO
